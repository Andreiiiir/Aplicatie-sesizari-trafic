{
  "expo": {
    "name": "SeficBuc",
    "slug": "seficbuc",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "seficbuc",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.seficbuc.app"
    },

    "android": {
      "package": "ro.seficbuc.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "plugins": [
      "expo-router",
      "expo-mail-composer"
    ],

    "assetBundlePatterns": [
      "**/*"
    ]
  }
}